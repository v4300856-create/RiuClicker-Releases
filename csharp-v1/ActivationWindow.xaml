<Window x:Class="RiuClicker.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiuClicker · License" Width="520" Height="390"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#090B13" Foreground="White">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="RIUCLICKER PRO" FontSize="12" FontWeight="Bold" Foreground="#22D3EE"/>
            <TextBlock Text="Activate your license" FontSize="30" FontWeight="Bold" Margin="0,8,0,6"/>
            <TextBlock Text="Enter the key you received after purchase. The first activation binds it to this PC." Foreground="#98A2B8" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,24,0,18" Padding="20" CornerRadius="18" Background="#121725" BorderBrush="#2A3347" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LICENSE KEY" Foreground="#98A2B8" FontSize="11" FontWeight="Bold"/>
                <TextBox x:Name="KeyBox" FontFamily="Consolas" FontSize="17" CharacterCasing="Upper" Margin="0,8,0,12" Height="44" VerticalContentAlignment="Center"/>
                <Button x:Name="ActivateButton" Content="ACTIVATE LICENSE" Height="46" Click="Activate_Click" Background="#7C3AED" BorderBrush="#8B5CF6"/>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="#98A2B8" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="Device:" Foreground="#69758C" VerticalAlignment="Center"/>
            <TextBlock x:Name="DeviceText" Grid.Column="1" Foreground="#8994AA" HorizontalAlignment="Right" FontFamily="Consolas"/>
        </Grid>
    </Grid>
</Window>
