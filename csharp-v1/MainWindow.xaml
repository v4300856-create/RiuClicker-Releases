<Window x:Class="RiuClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RiuClicker 1.0 · C# Lobby" Width="980" Height="670"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="RIUCLICKER · C#" Foreground="{StaticResource Accent2}" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="LOW LATENCY LOBBY" Foreground="{StaticResource Text}" FontWeight="Black" FontSize="30" Margin="0,3,0,0"/>
                <TextBlock Text="Persistent TCP · NoDelay · instant member list" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Panel2}" CornerRadius="12" Padding="16,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#64748B" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoleText" Text="OFFLINE" Foreground="{StaticResource Text}" FontWeight="Bold"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="PingText" Text="PING —" Foreground="{StaticResource Accent2}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="20">
                <StackPanel>
                    <TextBlock Text="CREATE LOBBY" Foreground="{StaticResource Accent}" FontWeight="Black" FontSize="18"/>
                    <TextBlock Text="Owner" Foreground="{StaticResource Muted}" Margin="0,2,0,13"/>
                    <TextBlock Text="Your name" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="NameBox" Text="Player"/>
                    <TextBlock Text="Port" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="PortBox" Text="42871"/>
                    <Button x:Name="HostButton" Content="CREATE LOBBY" Background="{StaticResource Accent}" Click="Host_Click" Margin="0,6,0,10"/>
                    <TextBlock Text="Lobby code" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="46"/>
                    <Button Content="COPY CODE" Click="CopyCode_Click"/>
                    <TextBlock Text="For internet play the router must accept this port. RiuClicker tries UPnP automatically." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="20">
                <StackPanel>
                    <TextBlock Text="JOIN LOBBY" Foreground="{StaticResource Accent2}" FontWeight="Black" FontSize="18"/>
                    <TextBlock Text="Member" Foreground="{StaticResource Muted}" Margin="0,2,0,13"/>
                    <TextBlock Text="Lobby code" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="JoinCodeBox" TextWrapping="Wrap" MinHeight="46"/>
                    <Button x:Name="JoinButton" Content="JOIN" Background="#0E7490" Click="Join_Click" Margin="0,6,0,4"/>
                    <Button Content="LEAVE LOBBY" Background="#3A1D2A" BorderBrush="#6B2A3C" Click="Leave_Click"/>
                    <Separator Margin="0,10" Background="#293146"/>
                    <TextBlock Text="Latency test" Foreground="{StaticResource Muted}"/>
                    <Button Content="SEND INSTANT TEST SIGNAL" Click="TestSignal_Click"/>
                    <TextBlock Text="The other PC should receive it immediately. Ping above shows the real round-trip delay." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="18" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="PLAYERS" Foreground="{StaticResource Text}" FontWeight="Black" FontSize="17"/>
                            <Border DockPanel.Dock="Right" Background="#20283A" CornerRadius="10" Padding="9,4">
                                <TextBlock x:Name="MemberCountText" Text="0 ONLINE" Foreground="{StaticResource Accent2}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DockPanel>
                        <ListBox x:Name="MembersList" Background="#0D111C" BorderBrush="#293146" Foreground="{StaticResource Text}" FontSize="15" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="LIVE EVENTS" Foreground="{StaticResource Text}" FontWeight="Black" FontSize="17" Margin="0,0,0,10"/>
                        <ListBox x:Name="LogList" Background="#0D111C" BorderBrush="#293146" Foreground="{StaticResource Muted}" Padding="8"/>
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Accent2}" Margin="2,9,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
