<Application x:Class="RiuClicker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0A0D16"/>
    <SolidColorBrush x:Key="Panel" Color="#E6151926"/>
    <SolidColorBrush x:Key="Panel2" Color="#C91C2232"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#8993AA"/>
    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Accent2" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5D73"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#242A3A"/>
      <Setter Property="BorderBrush" Value="#384156"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#151A27"/><Setter Property="BorderBrush" Value="#323A4E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111827"/><Setter Property="Background" Value="#E5E7EB"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,5,0,5"/></Style>
  </Application.Resources>
</Application>
