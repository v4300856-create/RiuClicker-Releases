local KEY_API = "https://rpbjeexhbanaavazfmpo.supabase.co/functions/v1/booga-key"
local CODE_API = "https://rpbjeexhbanaavazfmpo.supabase.co/functions/v1/booga-code"
local LOOT_URL = "https://loot-link.com/s?2VYw8jVk"
local SAVE_FOLDER = "BOOGA_HUB"
local SAVE_PATH = SAVE_FOLDER .. "/key.json"

local function ensureFolder()
    if type(makefolder) ~= "function" then return end
    pcall(function()
        if type(isfolder) == "function" then
            if not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end
        else
            makefolder(SAVE_FOLDER)
        end
    end)
end

local function readSaved()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    local ok, data = pcall(function()
        if not isfile(SAVE_PATH) then return nil end
        return HttpService:JSONDecode(readfile(SAVE_PATH))
    end)
    if ok and type(data) == "table" then return data end
    return nil
end

local function writeSaved(data)
    ensureFolder()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(SAVE_PATH, HttpService:JSONEncode(data))
    end)
end

local function getJson(url)
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or type(body) ~= "string" then return nil end
    local ok2, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if ok2 and type(data) == "table" then return data end
    return nil
end

local function validateKey(key)
    key = tostring(key or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if key == "" then return false, 0 end
    local data = getJson(KEY_API .. "/validate?key=" .. HttpService:UrlEncode(key))
    if data and data.valid == true and tonumber(data.remaining_seconds or 0) > 0 then
        return true, tonumber(data.remaining_seconds)
    end
    return false, 0
end

local function runProtected(key, remaining)
    writeSaved({
        key = key,
        expiresAt = os.time() + math.max(0, tonumber(remaining) or 0)
    })

    local ok, body = pcall(function()
        return game:HttpGet(CODE_API .. "?key=" .. HttpService:UrlEncode(key))
    end)
    if not ok or type(body) ~= "string" or #body < 10000 then
        warn("[BOOGA HUB] Protected payload unavailable")
        return false
    end

    local fn, err = loadstring(body)
    if not fn then
        warn("[BOOGA HUB] Payload compile failed: " .. tostring(err))
        return false
    end
    task.spawn(fn)
    return true
end

local saved = readSaved()
if saved and saved.key then
    local valid, remaining = validateKey(saved.key)
    if valid then
        runProtected(tostring(saved.key), remaining)
        return
    end
end

