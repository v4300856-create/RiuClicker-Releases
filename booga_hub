getBtn.MouseButton1Click:Connect(function()
    getBtn.Text = "CREATING..."
    local data = getJson(KEY_API .. "/start")
    if not data or data.ok ~= true or not data.session_id then
        status.Text = "Could not create a key session. Try again."
        status.TextColor3 = Color3.fromRGB(255, 103, 120)
        getBtn.Text = "GET KEY"
        return
    end

    sessionId = tostring(data.session_id)
    writeSaved({sessionId = sessionId})
    local link = LOOT_URL .. "&puid=" .. HttpService:UrlEncode(sessionId)

    if type(setclipboard) == "function" then
        pcall(setclipboard, link)
        status.Text = "LootLabs link copied. Open it and complete the task."
    else
        input.Text = link
        status.Text = "Copy the LootLabs link from the box and complete it."
    end

    status.TextColor3 = Color3.fromRGB(95, 220, 197)
    getBtn.Text = "LINK READY"
end)

checkBtn.MouseButton1Click:Connect(function()
    checkBtn.Text = "CHECKING..."

    local typed = tostring(input.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if typed:sub(1, 6) == "BOOGA-" then
        local valid, remaining = validateKey(typed)
        if valid then
            status.Text = "Key accepted. Loading protected hub..."
            status.TextColor3 = Color3.fromRGB(96, 230, 169)
            checkBtn.Text = "SUCCESS"
            if runProtected(typed, remaining) then
                task.wait(0.25)
                gui:Destroy()
            end
            return
        end
    end

    local state = readSaved()
    if not sessionId and state and state.sessionId then
        sessionId = tostring(state.sessionId)
    end
    if not sessionId then
        status.Text = "Press GET KEY first or paste an existing key."
        status.TextColor3 = Color3.fromRGB(255, 190, 95)
        checkBtn.Text = "CHECK KEY"
        return
    end

    local data = getJson(KEY_API .. "/status?session_id=" .. HttpService:UrlEncode(sessionId))
    if not data or data.ok ~= true then
        status.Text = "Server check failed. Try again."
        status.TextColor3 = Color3.fromRGB(255, 103, 120)
        checkBtn.Text = "CHECK KEY"
        return
    end
    if data.completed ~= true then
        status.Text = "LootLabs has not confirmed completion yet."
        status.TextColor3 = Color3.fromRGB(255, 190, 95)
        checkBtn.Text = "CHECK AGAIN"
        return
    end

    local key = tostring(data.key or "")
    local remaining = tonumber(data.remaining_seconds or 0)
    if key == "" or remaining <= 0 then
        status.Text = "Key expired. Press GET KEY for a new session."
        status.TextColor3 = Color3.fromRGB(255, 103, 120)
        checkBtn.Text = "GET NEW KEY"
        return
    end

    input.Text = key
    status.Text = "Access granted. Loading protected hub..."
    status.TextColor3 = Color3.fromRGB(96, 230, 169)
    checkBtn.Text = "SUCCESS"
    if runProtected(key, remaining) then
        task.wait(0.25)
        gui:Destroy()
    end
end)
