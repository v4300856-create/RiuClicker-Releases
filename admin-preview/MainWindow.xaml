<Window x:Class="RiuClickerAdmin.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RiuClicker Admin" Height="720" Width="1180"
 WindowStartupLocation="CenterScreen" Background="#0B0D14" Foreground="#F5F7FB">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#171C2A"/>
   <Setter Property="BorderBrush" Value="#2A3040"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="4"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#111622"/>
   <Setter Property="BorderBrush" Value="#2A3040"/>
   <Setter Property="Padding" Value="10"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#111622"/>
   <Setter Property="BorderBrush" Value="#2A3040"/>
   <Setter Property="Padding" Value="10"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="#111622"/>
   <Setter Property="BorderBrush" Value="#2A3040"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="#10141E" BorderBrush="#202637" BorderThickness="0,0,1,0">
   <StackPanel Margin="20">
    <TextBlock Text="RiuClicker" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="ADMIN · PRO" Foreground="#22D3EE" FontWeight="Bold" Margin="0,0,0,24"/>
    <Border Background="#1A2030" CornerRadius="10" Padding="12"><TextBlock Text="🔑  Licenses" FontWeight="Bold"/></Border>
    <TextBlock Text="Server-backed license panel" Foreground="#667085" FontSize="11" TextWrapping="Wrap" Margin="12,14,0,0"/>
   </StackPanel>
  </Border>

  <Grid Grid.Column="1" Margin="28">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <DockPanel>
    <TextBlock Text="Pro Licenses" FontSize="28" FontWeight="Bold"/>
    <Border DockPanel.Dock="Right" Background="#10251A" BorderBrush="#245B38" BorderThickness="1" CornerRadius="12" Padding="10,5">
     <TextBlock x:Name="ServerStateText" Text="● NOT CONNECTED" Foreground="#E7B84B" FontSize="11" FontWeight="Bold"/>
    </Border>
   </DockPanel>

   <Border Grid.Row="1" Background="#151A27" CornerRadius="14" Padding="16" Margin="0,20,0,16">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0">
      <TextBlock Text="ADMIN PASSWORD" Foreground="#8F98AD" FontSize="10" Margin="0,0,0,6"/>
      <PasswordBox x:Name="AdminPasswordBox" Height="38"/>
     </StackPanel>
     <Button Grid.Column="1" Content="CONNECT" Height="38" VerticalAlignment="Bottom" Background="#7657E8" BorderBrush="#7657E8" FontWeight="Bold" Click="Connect_Click"/>
     <Button Grid.Column="2" Content="REFRESH" Height="38" VerticalAlignment="Bottom" Click="Refresh_Click"/>
    </Grid>
   </Border>

   <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,18">
    <Border Background="#151A27" CornerRadius="14" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="TOTAL KEYS" Foreground="#8F98AD" FontSize="11"/><TextBlock x:Name="TotalText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
    <Border Background="#151A27" CornerRadius="14" Padding="16" Margin="5,0"><StackPanel><TextBlock Text="ACTIVE" Foreground="#8F98AD" FontSize="11"/><TextBlock x:Name="ActiveText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
    <Border Background="#151A27" CornerRadius="14" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="LIFETIME" Foreground="#8F98AD" FontSize="11"/><TextBlock x:Name="LifetimeText" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
   </UniformGrid>

   <Border Grid.Row="3" Background="#151A27" CornerRadius="14" Padding="16" Margin="0,0,0,16">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0">
      <TextBlock Text="CUSTOMER / NOTE" Foreground="#8F98AD" FontSize="10" Margin="0,0,0,6"/>
      <TextBox x:Name="CustomerBox" Height="38"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,10,0">
      <TextBlock Text="PLAN" Foreground="#8F98AD" FontSize="10" Margin="0,0,0,6"/>
      <ComboBox x:Name="PlanBox" Height="38" SelectedIndex="0">
       <ComboBoxItem Content="30 DAYS"/><ComboBoxItem Content="90 DAYS"/><ComboBoxItem Content="LIFETIME"/>
      </ComboBox>
     </StackPanel>
     <Button Grid.Column="2" Content="CREATE KEY" Height="38" VerticalAlignment="Bottom" Background="#7657E8" BorderBrush="#7657E8" FontWeight="Bold" Click="CreateKey_Click"/>
    </Grid>
   </Border>

   <Border Grid.Row="4" Background="#151A27" CornerRadius="14" Padding="12">
    <DataGrid x:Name="GridKeys" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      Background="#151A27" Foreground="White" BorderThickness="0"
      RowBackground="#151A27" AlternatingRowBackground="#121724" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="KEY" Binding="{Binding Key}" Width="1.5*"/>
      <DataGridTextColumn Header="PLAN" Binding="{Binding Plan}" Width="*"/>
      <DataGridTextColumn Header="CUSTOMER" Binding="{Binding Customer}" Width="*"/>
      <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
      <DataGridTextColumn Header="EXPIRES" Binding="{Binding Expires}" Width="1.2*"/>
      <DataGridTextColumn Header="DEVICE" Binding="{Binding Device}" Width="1.2*"/>
      <DataGridTemplateColumn Header="ACTIONS" Width="240">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <Button Content="COPY" Tag="{Binding}" Click="Copy_Click"/>
          <Button Content="RESET" Tag="{Binding}" Click="ResetHwid_Click"/>
          <Button Content="REVOKE" Tag="{Binding}" Background="#3B171B" BorderBrush="#6A252D" Click="Revoke_Click"/>
         </StackPanel>
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
  </Grid>
 </Grid>
</Window>